    "def count_ch_neutral(pdg):\n",
    "    charged = ak.sum(\n",
    "        (abs(pdg) == 321) | (abs(pdg) == 211),\n",
    "        axis=1\n",
    "    )\n",
    "    \n",
    "    neutral = ak.sum(\n",
    "        (abs(pdg) == 221) |\n",
    "        (abs(pdg) == 111) |\n",
    "        (abs(pdg) == 130),\n",
    "        axis=1\n",
    "    )\n",
    "    return charged, neutral"
   ]
